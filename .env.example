APP_URL="https://e-bike-zuverkaufen.de"

# --- Reply portal (set in Vercel -> Project -> Settings -> Environment Variables; never commit real values) ---
# Zoho SMTP for verkaufe@e-bike-zuverkaufen.de (use an app-specific password, port 465)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=verkaufe@e-bike-zuverkaufen.de
SMTP_PASS=
SMTP_FROM=verkaufe@e-bike-zuverkaufen.de
# Where order / enquiry notifications go (defaults to verkaufe@e-bike-zuverkaufen.de)
ORDER_EMAIL=verkaufe@e-bike-zuverkaufen.de
# Passcode for /admin/ (choose a long random value)
ADMIN_PASSCODE=
# Database: add Upstash Redis from the Vercel Storage tab; it sets these automatically
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
